//=============================================================================
// Direct Call Dispatch
//
// Resolved guest-to-guest direct calls are normal C++ calls. The attributed
// wrapper preserves that path while attaching static caller/call-site metadata
// for optional direct-call profiling.
//=============================================================================

#if defined(REXGLUE_ENABLE_PROFILING) || defined(REXGLUE_ENABLE_PERF_COUNTERS)
#include <rex/perf/counter.h>
#endif

#ifdef REXGLUE_ENABLE_PERF_COUNTERS
#define REX_PROFILE_GUEST_DIRECT_CALL_TARGET(source_address, source_symbol, call_site,       \
                                             target_address, target_symbol)                  \
  do {                                                                                       \
    if (rex::perf::IsGuestDirectCallProfileEnabled()) {                                      \
      PROFILE_GUEST_DIRECT_CALL_TARGET(source_address, source_symbol, call_site,             \
                                       target_address, target_symbol);                       \
    }                                                                                        \
  } while (false)
#else
#define REX_PROFILE_GUEST_DIRECT_CALL_TARGET(source_address, source_symbol, call_site,       \
                                             target_address, target_symbol)
#endif

#define REX_CALL_DIRECT_FUNC_AT(source_address, source_symbol, call_site, target_address, target_symbol, fn) \
  do {                                                                                                       \
    REX_PROFILE_GUEST_DIRECT_CALL_TARGET(source_address, source_symbol, call_site, target_address, target_symbol); \
    fn(ctx, base);                                                                                          \
  } while (0)
