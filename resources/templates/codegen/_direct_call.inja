//=============================================================================
// Direct Call Dispatch
//
// Resolved guest-to-guest direct calls are normal C++ calls. The attributed
// wrapper preserves that path while attaching static caller/call-site metadata
// only when generated direct-call profiling is compiled in.
//=============================================================================

#if defined(REXGLUE_ENABLE_PERF_COUNTERS) && defined(REXGLUE_PROFILE_GUEST_DIRECT_CALLS)
#include <rex/perf/counter.h>
#endif

#if defined(REXGLUE_ENABLE_PERF_COUNTERS) && defined(REXGLUE_PROFILE_GUEST_DIRECT_CALLS)
#define REX_CALL_DIRECT_FUNC_AT(source_address, source_symbol, call_site, target_address, target_symbol, fn) \
  do {                                                                                                       \
    const bool rex_profile_guest_direct_call_ = rex::perf::IsGuestDirectCallProfileEnabled();                \
    if (rex_profile_guest_direct_call_) {                                                                    \
      rex::perf::AddGuestDirectCallTarget(source_address, source_symbol, call_site, target_address,          \
                                          target_symbol);                                                    \
    }                                                                                                        \
    fn(ctx, base);                                                                                           \
    if (rex_profile_guest_direct_call_) {                                                                    \
      rex::perf::AddGuestDirectCallPostCallR3(source_address, source_symbol, call_site, target_address,      \
                                              target_symbol, ctx.r3.u32);                                    \
    }                                                                                                        \
  } while (0)
#else
#define REX_CALL_DIRECT_FUNC_AT(source_address, source_symbol, call_site, target_address, target_symbol, fn) \
  do {                                                                                                       \
    fn(ctx, base);                                                                                           \
  } while (0)
#endif
