//=============================================================================
// Indirect Call Dispatch
//
// REX_LOOKUP_FUNC indexes into the per-module dispatch table at
// IMAGE_BASE + IMAGE_SIZE. REX_CALL_INDIRECT_FUNC bounds-checks the target
// against the caller's [REX_CODE_BASE, REX_CODE_BASE + REX_CODE_SIZE +
// REX_THUNK_RESERVE_SIZE) range; out-of-bounds targets and in-bounds
// unregistered slots fall back to rex::runtime::ResolveIndirectFunction,
// which queries the global FunctionDispatcher across every loaded module.
//=============================================================================

#if defined(REXGLUE_ENABLE_PROFILING) || \
    (defined(REXGLUE_ENABLE_PERF_COUNTERS) && defined(REXGLUE_PROFILE_GUEST_INDIRECT_CALLS))
#include <rex/perf/counter.h>
#endif

#ifdef REXGLUE_ENABLE_PROFILING
#define REX_PROFILE_INDIRECT_DISPATCH() PROFILE_FUNCTION_DISPATCHED()
#else
#define REX_PROFILE_INDIRECT_DISPATCH()
#endif

#if defined(REXGLUE_ENABLE_PERF_COUNTERS) && defined(REXGLUE_PROFILE_GUEST_INDIRECT_CALLS)
#define REX_PROFILE_GUEST_INDIRECT_CALL_TARGET(source_address, source_symbol, call_site,      \
                                               target_address, fast_path_hit)                 \
  do {                                                                                        \
    if (rex::perf::IsGuestIndirectCallProfileEnabled()) {                                     \
      rex::perf::AddGuestIndirectCallTarget(source_address, source_symbol, call_site,         \
                                            target_address, fast_path_hit);                   \
    }                                                                                         \
  } while (false)
#else
#define REX_PROFILE_GUEST_INDIRECT_CALL_TARGET(source_address, source_symbol, call_site, \
                                               target_address, fast_path_hit)
#endif

#define REX_LOOKUP_FUNC(x, offset) \
  (*(PPCFunc**)(x + REX_IMAGE_BASE + REX_IMAGE_SIZE + (u64(u32(offset)) * 2)))

#if defined(_MSC_VER)
#define REX_GENERATED_FORCE_INLINE __forceinline
#else
#define REX_GENERATED_FORCE_INLINE inline __attribute__((always_inline))
#endif

namespace rex::generated {

struct IndirectCallResolution {
  PPCFunc* func = nullptr;
  bool fast_path_hit = false;
};

struct IndirectCallCache {
  uint64_t generation = 0;
  uint32_t target = 0;
  PPCFunc* func = nullptr;
  bool fast_path_hit = false;
};

static REX_GENERATED_FORCE_INLINE IndirectCallResolution ResolveIndirectCallTarget(
    PPCContext& ctx, uint8_t* base, uint32_t target, IndirectCallCache& cache) {
  const uint64_t generation = rex::runtime::IndirectDispatchGeneration();
  if (cache.generation == generation && cache.target == target && cache.func) [[likely]] {
    return {.func = cache.func, .fast_path_hit = cache.fast_path_hit};
  }

  IndirectCallResolution result;
  const uint32_t offset = static_cast<uint32_t>(target - REX_CODE_BASE);
  if (offset < REX_CODE_SIZE + REX_THUNK_RESERVE_SIZE) [[likely]] {
    result.func = REX_LOOKUP_FUNC(base, offset);
    result.fast_path_hit = result.func != nullptr;
  }

  if (!result.func) [[unlikely]] {
    ctx.last_indirect_target = target;
    result.func = rex::runtime::ResolveIndirectFunction(target);
  }
  if (result.fast_path_hit) {
    cache = {
        .generation = generation,
        .target = target,
        .func = result.func,
        .fast_path_hit = true,
    };
  }
  return result;
}

}  // namespace rex::generated

#undef REX_GENERATED_FORCE_INLINE

#define REX_CALL_INDIRECT_FUNC_AT(source_address, source_symbol, call_site, x) \
  REX_CALL_INDIRECT_FUNC_AT_IMPL(__COUNTER__, source_address, source_symbol, call_site, x)

#define REX_CALL_INDIRECT_FUNC_AT_IMPL(cache_id, source_address, source_symbol, call_site, x) \
  REX_CALL_INDIRECT_FUNC_AT_IMPL2(cache_id, source_address, source_symbol, call_site, x)

#define REX_CALL_INDIRECT_FUNC_AT_IMPL2(cache_id, source_address, source_symbol, call_site, x) \
  do {                                                                                       \
    REX_PROFILE_INDIRECT_DISPATCH();                                                         \
    static thread_local rex::generated::IndirectCallCache REX_JOIN(rex_indirect_cache_,      \
                                                                   cache_id);                \
    uint32_t rex_indirect_target_ = (uint32_t)(x);                                           \
    const auto rex_indirect_call_ =                                                          \
        rex::generated::ResolveIndirectCallTarget(ctx, base, rex_indirect_target_,            \
                                                  REX_JOIN(rex_indirect_cache_, cache_id));   \
    REX_PROFILE_GUEST_INDIRECT_CALL_TARGET(source_address, source_symbol, call_site,          \
                                           rex_indirect_target_,                              \
                                           rex_indirect_call_.fast_path_hit);                 \
    (void)rex_indirect_call_.fast_path_hit;                                                   \
    rex_indirect_call_.func(ctx, base);                                                       \
  } while (0)

#define REX_CALL_INDIRECT_FUNC(x) REX_CALL_INDIRECT_FUNC_AT(0, "", 0, (x))
